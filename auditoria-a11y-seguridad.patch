+// Accesibilidad del modal: recuerda el foco previo, oculta el fondo a lectores y mueve el foco al sheet
+let sheetPrevFocus=null;
+function bgInert(on){
+  [document.querySelector(".topbar"), document.getElementById("views"), document.querySelector(".tabbar")]
+    .forEach(el=>{ if(!el) return; if(on) el.setAttribute("aria-hidden","true"); else el.removeAttribute("aria-hidden"); });
+}
+function openSheet(){
+  sheetPrevFocus = document.activeElement;
+  const sh=document.getElementById("sheet");
+  document.getElementById("sheetBg").classList.add("open");
+  sh.classList.add("open"); sh.setAttribute("aria-hidden","false");
+  bgInert(true);
+  const foco = sh.querySelector("input,select,textarea,button,[tabindex]") || sh;
+  try{ foco.focus(); }catch(e){}
+}
+function closeSheet(){
+  const sh=document.getElementById("sheet");
+  document.getElementById("sheetBg").classList.remove("open");
+  sh.classList.remove("open"); sh.setAttribute("aria-hidden","true");
+  bgInert(false); sheetState=null;
+  if(sheetPrevFocus && sheetPrevFocus.focus){ try{ sheetPrevFocus.focus(); }catch(e){} }
+  sheetPrevFocus=null;
+}
 
